# Content-agent runtime only (planner / reflector / consolidation / scripts/openrouter_smoke.py).
# Export these in the process environment. The app reads os.environ and never
# embeds a key. Do not commit a filled-in .env.
#
# openrouter/free is the zero-price Free Models Router
# (https://openrouter.ai/openrouter/free). It picks a free model that fits the
# request. Pin a specific free model with a `:free` suffix if you need a stable
# id, for example meta-llama/llama-3.2-3b-instruct:free.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Context engineering flags. Builder / compress / skills default off in code
# so the legacy prompt path keeps working. Artifact offload defaults on.
# AGENT_CONTEXT_BUILDER_ENABLED=false
# AGENT_OBS_COMPRESS_ENABLED=false
# AGENT_SKILLS_ENABLED=false
# AGENT_ARTIFACT_OFFLOAD_ENABLED=true
# AGENT_CONTEXT_WINDOW_TOKENS=128000
